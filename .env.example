BOT_TOKEN=your_bot_token

# Optional settings (defaults shown)
# Ignore messages older than this many seconds (e.g. sent while the bot was offline)
#MAX_MESSAGE_AGE_SECONDS=300
# How many links are downloaded at the same time
#MAX_CONCURRENT_JOBS=2
# How many links can wait in the queue
#MAX_QUEUE_SIZE=50
# Use tikwm.com as a fallback for TikTok photo posts when TikTok blocks page scraping
#TIKTOK_PHOTO_FALLBACK=true
# Custom Bot API server, e.g. a self-hosted telegram-bot-api
#TELEGRAM_API_ROOT=
